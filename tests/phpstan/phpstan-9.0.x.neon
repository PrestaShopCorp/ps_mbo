parameters:
  bootstrapFiles:
    - bootstrap.php
  paths:
    - ../../src
    - ../../ps_mbo.php
    # Tests folder
    - ..
    - ../../bootstrap.php
  dynamicConstantNames:
    - _PS_VERSION_
    - ps_mbo::VERSION
  ignoreErrors:
    # ps_accounts is not always present in the analysed PrestaShop install
    - message: '#^Class PrestaShop\\Module\\PsAccounts\\Repository\\UserTokenRepository not found.$#'
      reportUnmatched: false
  level: 5
